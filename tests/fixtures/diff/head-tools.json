{
  "tools": [
    {
      "name": "search_docs",
      "description": "Search docs with filters and ranking controls.",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {"type": "string", "description": "Natural language search query."},
          "limit": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10},
          "source": {"type": "string", "enum": ["docs", "issues", "code"], "default": "docs"}
        }
      }
    },
    {
      "name": "read_doc",
      "description": "Read a document by ID.",
      "inputSchema": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"}
        }
      }
    }
  ]
}
